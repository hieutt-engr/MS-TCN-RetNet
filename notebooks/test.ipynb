   "source": [
    "from datetime import timedelta\n",
    "\n",
    "\n",
    "def gettime_nextday (today = None, holiday = False):\n",
    "    if holiday:\n",
    "        return today\n",
    "    else:\n",
    "        return today + timedelta(days=1)"
   ]
  },
